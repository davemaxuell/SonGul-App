# SonGul feedback gateway — copy to server/.env and edit.

# Port the gateway listens on (default 8787, bound to 0.0.0.0 for LAN tablets)
#SONGUL_PORT=8787

# How long the POST waits before flipping to the async pending/poll envelope
#SONGUL_SYNC_BUDGET_MS=1500

# ── The AI plug-in point ─────────────────────────────────────────────
# Set these when the real handwriting-feedback AI API is available, then
# fill in the two mapping functions in server/providers/externalAi.ts.
#SONGUL_AI_URL=https://api.example.com/v1/handwriting-feedback
#SONGUL_AI_KEY=sk-...
#SONGUL_AI_TIMEOUT_MS=8000
