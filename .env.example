# SonGul cloud backup (Supabase) — copy to .env and fill in.
# Both values come from your Supabase project: Project Settings -> API.
# The anon/publishable key is safe to embed in the client build.
# See docs/SUPABASE_SETUP.md for the one-time server setup.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
